[Unit]
Description=Log archive: collect yesterday's logs
Documentation=https://github.com/Lukas0923xcv/logs
After=network-online.target remote-fs.target
Wants=network-online.target

[Service]
Type=oneshot
User=logs-collector
Group=logs-collector
WorkingDirectory=/usr/local/share/logs/ansible
# Optional file for secrets such as LOGS_SMTP_PASSWORD (mode 0600, owner root).
EnvironmentFile=-/etc/logs/collector.secrets.env
Environment=HOME=/var/lib/logs-collector ANSIBLE_NOCOLOR=1
ExecStart=/usr/bin/ansible-playbook -i /etc/logs/inventory.yml collect.yml
Nice=10
# No NoNewPrivileges here: collecting the collector's own logs may use sudo.
PrivateTmp=yes
ProtectHome=yes
