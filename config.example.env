# Configuration of the web UI (logs-webui).
# install.sh copies this file to /etc/logs/webui.env once and never overwrites it.
# After a change: sudo systemctl restart logs-webui

# Directory with raw/, archive/ and manifests/. Use the read-only mount.
LOGS_DATA_DIR=/mnt/logs-ro

# Address and port to listen on. The default is reachable from this host only.
# To reach it from other machines use e.g. 0.0.0.0:8484 and then turn on
# LOGS_BASIC_AUTH_FILE or put an authenticating reverse proxy in front of it.
LOGS_LISTEN=127.0.0.1:8484

# Title shown in the page header.
#LOGS_TITLE=Log archive

# Optional basic auth: path of an htpasswd file with bcrypt hashes.
# Create it with:  htpasswd -cB /etc/logs/htpasswd logcollector
# then:            chown root:logs-web /etc/logs/htpasswd && chmod 640 /etc/logs/htpasswd
#LOGS_BASIC_AUTH_FILE=/etc/logs/htpasswd

# How often the statistics index looks for new manifests.
#LOGS_INDEX_REFRESH=5m

# Text filter limits: stop after this many matching lines or this much time.
#LOGS_FILTER_MAX_RESULTS=500
#LOGS_FILTER_TIMEOUT=15s

# Size of one page in the log viewer, in bytes.
#LOGS_PAGE_BYTES=65536

# Downloads of single files out of archives that may run at the same time.
# Each one needs up to LOGS_ZSTD_MAX_WINDOW_MB of memory.
#LOGS_ARCHIVE_STREAMS=1

# Largest zstd window the UI accepts when it decompresses an archive, in MiB.
# 32 fits archives made with logs_zstd_window_log up to 25 inside MemoryMax=64M.
#LOGS_ZSTD_MAX_WINDOW_MB=32
